# DocuMind Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── REQUIRED ──────────────────────────────────────────────
# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── SECURITY ──────────────────────────────────────────────
# Secret key for signing JWT tokens — change this to a random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=documind-dev-secret-change-in-production-please

# ── STORAGE ───────────────────────────────────────────────
# Where uploaded files are stored on disk
UPLOAD_DIR=./uploads

# Where the FAISS vector index is stored on disk
FAISS_INDEX_DIR=./faiss_store
